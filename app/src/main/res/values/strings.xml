<resources>
    <string name="app_name">ColorOS 16 液态玻璃</string>
    <string name="app_description">让 ColorOS 16 的通知中心和控制中心拥有 iOS 26 液态玻璃效果。</string>

    <!-- 导航（[spec/88] 扩大返回键热区的无障碍描述） -->
    <string name="settings_back">返回</string>

    <!-- 总开关 -->
    <string name="settings_master">启用模块（默认关闭）</string>
    <string name="settings_master_desc">模块总开关，默认关闭。开启后重启系统界面即可生效。</string>
    <string name="settings_glass_enable">液态玻璃渲染</string>
    <string name="settings_glass_enable_desc">关闭后改用系统模糊，约半秒生效；倾斜、横幅飞入等效果不受影响。</string>
    <string name="settings_hint">模块默认关闭，开启后才会生效。部分改动需重启系统界面、桌面或锁屏后生效。</string>

    <!-- 液态玻璃材质 -->
    <string name="settings_material_preview">效果预览（实时）</string>
    <string name="settings_section_material">液态玻璃参数</string>
    <string name="settings_blur_radius">模糊半径（px）</string>
    <string name="settings_blur_radius_value">%1$d px</string>
    <string name="settings_blur_radius_desc">玻璃内部的轻微模糊。0 表示完全清晰；调得太大可能出现条纹。</string>
    <string name="settings_vibrancy">色彩鲜艳度</string>
    <string name="settings_vibrancy_value">%1$.2fx</string>
    <string name="settings_vibrancy_desc">1.0 为原始颜色，越大颜色越浓。</string>
    <string name="settings_highlight_falloff">高光集中度</string>
    <string name="settings_highlight_falloff_value">%1$d</string>
    <string name="settings_highlight_falloff_desc">数值越大，高光越集中在光源方向。</string>
    <string name="settings_refraction_amount">折射强度（px）</string>
    <string name="settings_refraction_amount_value">%1$d px</string>
    <string name="settings_refraction_amount_desc">折射位移强度，越大背景扭曲越明显。</string>
    <string name="settings_refraction_height_ratio">折射范围：按比例</string>
    <string name="settings_refraction_height_ratio_value">%1$.2f</string>
    <string name="settings_refraction_height_ratio_desc">折射带占元素短边的比例。0.50 为默认，数值越大，边缘扭曲范围越宽。</string>
    <string name="settings_refraction_height_mode">折射范围</string>
    <string name="settings_refraction_height_mode_desc">按比例：元素越大，折射带越宽；固定像素：所有元素一样宽。</string>
    <string name="settings_refraction_height_px">折射范围：固定像素</string>
    <string name="settings_refraction_height_px_value">%1$d px</string>
    <string name="settings_refraction_height_px_desc">折射带固定为这么多像素，不随元素大小变化。</string>
    <string name="settings_dispersion">边缘色散</string>
    <string name="settings_dispersion_value">%1$.2f</string>
    <string name="settings_dispersion_desc">背景边缘彩虹边，0 关闭，0.05~0.3 适中。</string>
    <string name="settings_depth">立体深度</string>
    <string name="settings_depth_value">%1$.2f</string>
    <string name="settings_depth_desc">玻璃曲面深度，越大弯曲/折射越明显。</string>
    <string name="settings_highlight">高光亮度</string>
    <string name="settings_highlight_value">%1$.2f</string>
    <string name="settings_highlight_desc">高光亮度，越大越亮。</string>
    <string name="settings_highlight_width">高光宽度（px）</string>
    <string name="settings_highlight_width_value">%1$d px</string>
    <string name="settings_highlight_width_desc">高光带宽度，越大越宽。</string>
    <string name="settings_highlight_floor">圆角高光保底</string>
    <string name="settings_highlight_floor_value">%1$d%%</string>
    <string name="settings_highlight_floor_desc">圆角处的最低高光。0 只保留方向感，圆角偏暗；1 让整圈都有一条均匀亮边。</string>
    <string name="settings_highlight_inner_att">内侧高光衰减</string>
    <string name="settings_highlight_inner_att_value">%1$d%%</string>
    <string name="settings_highlight_inner_att_desc">控制高光向玻璃内部衰减的程度。0 为默认；越大，内侧高光越暗、内侧光越贴边。</string>
    <string name="settings_inner_glow">内侧光</string>
    <string name="settings_inner_glow_value">%1$d%%</string>
    <string name="settings_inner_glow_desc">玻璃边缘向中心散发的柔光。0 表示关闭。</string>
    <string name="settings_light_angle">光源方向</string>
    <string name="settings_light_angle_value">%1$d°</string>
    <string name="settings_light_angle_desc">高光光源方向角度。</string>
    <string name="settings_parallax_x">背景水平偏移</string>
    <string name="settings_parallax_x_value">%1$d px</string>
    <string name="settings_parallax_x_desc">背景水平偏移，0 表示关闭。</string>
    <string name="settings_parallax_y">背景垂直偏移</string>
    <string name="settings_parallax_y_value">%1$d px</string>
    <string name="settings_parallax_y_desc">背景垂直偏移，0 表示关闭。</string>

    <!-- 统一界面圆角（通知/控制中心） -->
    <string name="settings_unified_corner">统一界面圆角（通知/控制中心）</string>
    <string name="settings_unified_corner_desc">通知中心和控制中心使用同一圆角。圆形和药丸形控件保持原样；桌面、锁屏不受影响。</string>
    <string name="settings_unified_corner_px">统一圆角（px）</string>
    <string name="settings_unified_corner_px_value">%1$d px</string>
    <string name="settings_unified_corner_px_desc">统一使用的圆角大小。较小的圆角会放大到该值；圆形和药丸形控件不变。</string>

    <!-- 背景与抓屏 -->
    <string name="settings_capture_params_section">背景刷新</string>
    <string name="settings_capture_mode">模式</string>
    <string name="settings_capture_mode_desc">即时抓屏按固定速率持续抓屏；变化抓屏在内容变化时立即抓屏，无变化时按最大抓屏间隔兜底；静态不抓屏，背景保持当前画面。</string>
    <string name="settings_capture_mode_immediate">即时抓屏</string>
    <string name="settings_capture_mode_on_change">变化抓屏</string>
    <string name="settings_capture_mode_static">静态</string>
    <string name="settings_panel_capture_hz">即时抓屏速率</string>
    <string name="settings_panel_capture_hz_value">%1$d Hz</string>
    <string name="settings_panel_capture_hz_desc">通知横幅、流体云卡与小横幅等瞬态场景的抓屏速率。越高越跟手，也越耗电。</string>
    <string name="settings_capture_scale">背景清晰度</string>
    <string name="settings_capture_scale_value">%1$.2fx</string>
    <string name="settings_capture_scale_desc">背景采样清晰度。0.5 更省电，1.0 更清晰。</string>
    <string name="settings_periodic_capture_interval">最大抓屏间隔</string>
    <string name="settings_periodic_capture_interval_value">%1$d ms</string>
    <string name="settings_periodic_capture_interval_desc">没有内容变化时的兜底抓屏间隔，默认 500 毫秒，仅变化抓屏模式显示。</string>
    <string name="settings_section_capture_retry">抓屏开关</string>
    <string name="settings_capture_retry_enabled">失败重试</string>
    <string name="settings_capture_retry_enabled_desc">背景抓屏失败后自动重试，固定 320 毫秒一次、最多 3 次。</string>
    <string name="settings_bg_region_capture_experimental">区域级抓屏（实验性）</string>
    <string name="settings_bg_region_capture_experimental_desc">仅通知横幅、流体云卡、小横幅等小区域场景生效，抓屏范围缩小到这些区域。默认关闭。</string>
    <string name="settings_bg_wallpaper_max_dim">壁纸处理最大尺寸</string>
    <string name="settings_bg_wallpaper_max_dim_value">%1$d px</string>
    <string name="settings_bg_wallpaper_max_dim_desc">限制壁纸处理尺寸，避免占用过多内存。</string>
    <string name="settings_section_cc_blur">系统控制中心模糊</string>
    <string name="settings_cc_blur_strength">系统模糊力度（%）</string>
    <string name="settings_cc_blur_strength_value">%1$d%%</string>
    <string name="settings_cc_blur_strength_desc">调整控制中心背景模糊程度。100 为系统默认，0 为不模糊。</string>
    <string name="settings_keep_system_cc_blur">保留系统控制中心模糊（默认关）</string>
    <string name="settings_keep_system_cc_blur_desc">开启后保留系统模糊；关闭后背景透明，直接显示壁纸。</string>
    <string name="settings_remove_panel_mix_color">移除面板灰底</string>
    <string name="settings_remove_panel_mix_color_desc">去掉系统面板背景的灰色底，模糊效果仍然保留。</string>

    <!-- 文字与可读性 -->
    <string name="settings_text_contrast">文字自动反色</string>
    <string name="settings_text_contrast_desc">根据背景明暗自动切换文字黑白；关闭后使用系统默认逻辑。</string>
    <string name="settings_heads_up_text_follow">横幅文字跟随背景</string>
    <string name="settings_heads_up_text_follow_desc">弹出通知的文字颜色：开启遮罩时强制白色，关闭时按背景明暗自动调整。</string>
    <string name="settings_text_force_refresh_interval">文字颜色刷新间隔</string>
    <string name="settings_text_force_refresh_interval_value">%1$d ms</string>
    <string name="settings_text_force_refresh_interval_desc">定期重新检查文字颜色，让同屏颜色更统一。0 表示只在事件发生时检查。</string>

    <!-- 遮罩 -->
    <string name="settings_mask">黑遮罩（默认开）</string>
    <string name="settings_mask_desc">在玻璃上叠加半透明黑色，让文字更清楚。文字强制白是独立开关。</string>
    <string name="settings_mask_alpha">遮罩不透明度</string>
    <string name="settings_mask_alpha_value">%1$.2f</string>
    <string name="settings_mask_alpha_desc">面板黑色遮罩的浓度。0 为透明，1 为全黑，默认 0.45。</string>
    <string name="settings_mask_glass_dim">玻璃内压暗</string>
    <string name="settings_mask_glass_dim_value">%1$.2f</string>
    <string name="settings_mask_glass_dim_desc">玻璃内部背景的变暗程度。0 不变暗，1 全黑，默认 0。</string>
    <string name="settings_mask_text_color">文字强制白颜色</string>
    <string name="settings_mask_text_color_white">纯白</string>
    <string name="settings_mask_text_color_lightgray">浅灰</string>
    <string name="settings_mask_text_color_gray">灰</string>
    <string name="settings_mask_text_color_desc">开启文字强制白后，中性色文字统一成该颜色；彩色文字保持原样。</string>
    <string name="settings_text_force_white">文字强制白（默认开）</string>
    <string name="settings_text_force_white_desc">玻璃区域和横幅中的中性色文字始终为白色。可单独开启，不必同时压暗背景。</string>

    <!-- 流体云 -->
    <string name="settings_seedling_card_glass">流体云液态玻璃（默认关）</string>
    <string name="settings_seedling_card_glass_desc">灵动岛/流体云的液态玻璃总开关，横幅玻璃也受此控制。</string>
    <string name="settings_seedling_capsule_glass">小胶囊（小岛）也玻璃化（默认开）</string>
    <string name="settings_seedling_capsule_glass_desc">小胶囊也显示玻璃效果；关闭后只处理展开的大卡片。</string>
    <string name="settings_seedling_expand_ratio">展开卡片判定</string>
    <string name="settings_seedling_expand_ratio_value">%1$.2f</string>
    <string name="settings_seedling_expand_ratio_desc">判断卡片是否为展开状态的高度阈值，默认 0.6。</string>
    <string name="settings_seedling_corner_ratio">展开卡片圆角</string>
    <string name="settings_seedling_corner_ratio_value">%1$.2f</string>
    <string name="settings_seedling_corner_ratio_desc">展开卡片的圆角大小，默认 0.22。</string>
    <string name="settings_seedling_force_transparent_bg">透明卡片背景（默认开）</string>
    <string name="settings_seedling_force_transparent_bg_desc">展开卡片背景透明，让液态玻璃透出。</string>

