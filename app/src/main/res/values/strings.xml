    <string name="cat_anim">桌面动画</string>
    <string name="cat_anim_desc">打开 / 关闭 / 打断动画弹簧参数</string>
    <string name="settings_anim_intro">调整桌面过渡动画的弹簧刚度与阻尼。默认全部关闭，不开启时与原版动画完全一致；修改后立即生效。</string>
