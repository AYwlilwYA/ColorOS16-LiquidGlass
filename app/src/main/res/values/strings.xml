    <!-- 桌面 Dock 栏液态玻璃（doc/spec/66，2026-09-16） -->
    <string name="cat_desktop">桌面</string>
    <string name="cat_desktop_desc">桌面元素的液态玻璃</string>
    <string name="settings_dock_glass">Dock 栏液态玻璃</string>
    <string name="settings_dock_glass_desc">为桌面底部 Dock 栏添加液态玻璃背景。开启后立即生效，无需重启桌面。</string>

    <!-- 桌面「问小布」入口与卡片/小组件液态玻璃 -->
    <string name="settings_page_indicator_glass">问小布搜索栏液态玻璃</string>
    <string name="settings_page_indicator_glass_desc">给桌面底部「问小布」入口加液态玻璃背景。它和页面小圆点是同一个控件的两种状态，系统已自备模糊底，开启后由模块接管渲染。开启后立即生效，无需重启桌面。</string>
    <string name="settings_card_glass">卡片 / 小组件液态玻璃</string>
    <string name="settings_card_glass_desc">给桌面上的卡片、分组卡片、小组件背景加液态玻璃。这些背景的模糊由系统统一产生，开启后由模块接管渲染。开启后立即生效，无需重启桌面。</string>

    <!-- 组件玻璃化分类（音量条 / 第三方 App） -->
    <string name="cat_components">其他组件</string>
    <string name="cat_components_desc">音量条与相册、计算器、智能侧边栏的液态玻璃</string>
    <string name="settings_volume_seekbar_glass">音量条液态玻璃</string>
    <string name="settings_volume_seekbar_glass_desc">给调节音量时弹出的竖向音量条加液态玻璃背景。开启后立即生效，无需重启系统界面。</string>
    <string name="settings_volume_panel_clean">进度条亮白填充</string>
    <string name="settings_volume_panel_clean_desc">把音量滑杆的进度条改成亮白磨砂填充，顶边加一道高光，在玻璃背景上更清晰。开启后立即生效，无需重启系统界面。</string>
    <string name="settings_volume_panel_backdrop">音量面板去白底</string>
    <string name="settings_volume_panel_backdrop_desc">去掉展开音量面板背后那层模糊的发白底色，只保留模糊效果。关闭即恢复系统原样。开启后立即生效，无需重启系统界面。</string>
    <string name="settings_gallery_glass">相册液态玻璃</string>
    <string name="settings_gallery_glass_desc">把相册里的视图背景模糊接管成液态玻璃。该功能依赖相册自身的模糊实现，不同界面效果可能不一致。</string>
    <string name="settings_calculator_glass">计算器液态玻璃</string>
    <string name="settings_calculator_glass_desc">把计算器的对话框与弹出菜单背景模糊接管成液态玻璃。</string>
    <string name="settings_smart_sidebar_glass">智能侧边栏液态玻璃</string>
    <string name="settings_smart_sidebar_glass_desc">把智能侧边栏面板与卡片的背景模糊接管成液态玻璃。</string>
    <string name="settings_gallery_shader_probe">相册采样范围探针（实验）</string>
    <string name="settings_gallery_shader_probe_desc">临时替换相册背景模糊做诊断：元素边缘出现红色环＝模糊取到了元素外面的背景（可以做真折射），绿色环＝只取到元素内的内容。开启后相册背景会变清晰并带一圈色环，关掉即恢复原模糊。</string>

