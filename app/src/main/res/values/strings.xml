<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ColorOS16 Liquid Glass</string>
    <string name="app_description">为 ColorOS 16 通知中心/控制中心实现 iOS 26 液态玻璃效果（LibXposed 模块）</string>

    <!-- 总开关 -->
    <string name="settings_master">启用模块（默认关闭）</string>
    <string name="settings_master_desc">模块总开关，默认关闭。开启后重启 SystemUI 让全部 hook 生效。</string>
    <string name="settings_hint">模块默认关闭，开启后才生效。改动需重启对应进程（SystemUI/Launcher/锁屏）生效。</string>

    <!-- 液态玻璃材质 -->
    <string name="settings_section_material">液态玻璃参数</string>
    <string name="settings_blur_radius">模糊半径（px）</string>
    <string name="settings_blur_radius_value">%1$d px</string>
    <string name="settings_blur_radius_desc">玻璃内部轻模糊，0 = 清晰透镜。过大可能出现采样条带。</string>
    <string name="settings_vibrancy">鲜艳度（Vibrancy）</string>
    <string name="settings_vibrancy_value">%1$.2fx</string>
    <string name="settings_vibrancy_desc">颜色鲜艳度，1.0 不变，越大越饱和。</string>
    <string name="settings_highlight_falloff">高光衰减（Highlight Falloff）</string>
    <string name="settings_highlight_falloff_value">%1$d</string>
    <string name="settings_highlight_falloff_desc">高光聚光程度，越大越集中在光源方向。</string>
    <string name="settings_refraction_amount">折射强度（px）</string>
    <string name="settings_refraction_amount_value">%1$d px</string>
    <string name="settings_refraction_amount_desc">折射位移强度，越大背景扭曲越明显。</string>
    <string name="settings_dispersion">色散（Dispersion）</string>
    <string name="settings_dispersion_value">%1$.2f</string>
    <string name="settings_dispersion_desc">背景边缘彩虹边，0 关闭，0.05~0.3 适中。</string>
    <string name="settings_depth">深度（Depth）</string>
    <string name="settings_depth_value">%1$.2f</string>
    <string name="settings_depth_desc">玻璃曲面深度，越大弯曲/折射越明显。</string>
    <string name="settings_highlight">高光强度（Highlight）</string>
    <string name="settings_highlight_value">%1$.2f</string>
    <string name="settings_highlight_desc">高光亮度，越大越亮。</string>
    <string name="settings_highlight_width">高光宽度（px）</string>
    <string name="settings_highlight_width_value">%1$d px</string>
    <string name="settings_highlight_width_desc">高光带宽度，越大越宽。</string>
    <string name="settings_highlight_floor">弧线高光保底</string>
    <string name="settings_highlight_floor_value">%1$d%%</string>
    <string name="settings_highlight_floor_desc">圆角弧线处的高光保底。0 = 只保留方向性（弧线因法线与光源垂直而偏暗）；1 = 整圈均匀一条亮线（相当于直接描一条边）。</string>
    <string name="settings_light_angle">光角度（Light Angle）</string>
    <string name="settings_light_angle_value">%1$d°</string>
    <string name="settings_light_angle_desc">高光光源方向角度。</string>
    <string name="settings_parallax_x">视差 X（Parallax X）</string>
    <string name="settings_parallax_x_value">%1$d px</string>
    <string name="settings_parallax_x_desc">背景采样水平偏移，0 关闭视差。</string>
    <string name="settings_parallax_y">视差 Y（Parallax Y）</string>
    <string name="settings_parallax_y_value">%1$d px</string>
    <string name="settings_parallax_y_desc">背景采样垂直偏移，0 关闭视差。</string>

    <!-- 背景与抓屏 -->
    <string name="settings_capture_params_section">抓屏速率</string>
    <string name="settings_capture_min_interval">抓屏节流（内容变化最小间隔，0=立即抓）</string>
    <string name="settings_capture_min_interval_value">%1$d ms</string>
    <string name="settings_capture_min_interval_desc">内容变化后抓屏最小间隔，0 立即抓，越大越省电。</string>
    <string name="settings_panel_capture_hz">通知横幅抓屏速率（Hz）</string>
    <string name="settings_panel_capture_hz_value">%1$d Hz</string>
    <string name="settings_panel_capture_hz_desc">横幅/流体云显示期间抓屏频率，运动满速/静止减半，越大越跟手。</string>
    <string name="settings_capture_scale">抓屏降采样</string>
    <string name="settings_capture_scale_value">%1$.2fx</string>
    <string name="settings_capture_scale_desc">抓屏分辨率倍率，0.5 半分辨率省电，1.0 全分辨率清晰。</string>
    <string name="settings_periodic_capture">持续抓屏（通知/图标显示期间定期刷新背景，默认开）</string>
    <string name="settings_periodic_capture_desc">活跃宿主期间按间隔重抓整屏快照，动态背景实时。关闭=仅内容变化时抓屏。</string>
    <string name="settings_periodic_capture_interval">持续抓屏间隔（毫秒）</string>
    <string name="settings_periodic_capture_interval_value">%1$d ms</string>
    <string name="settings_periodic_capture_interval_desc">持续抓屏间隔，默认 500ms 实时与功耗平衡。</string>
    <string name="settings_section_capture_retry">抓屏失败重试</string>
    <string name="settings_capture_retry_ms">抓屏失败重试间隔（毫秒）</string>
    <string name="settings_capture_retry_ms_value">%1$d ms</string>
    <string name="settings_capture_retry_ms_desc">抓屏失败后的重试间隔。</string>
    <string name="settings_capture_retry_limit">抓屏失败重试次数</string>
    <string name="settings_capture_retry_limit_value">%1$d</string>
    <string name="settings_capture_retry_limit_desc">重试次数上限，用尽后暂停到下次内容变化。</string>
    <string name="settings_bg_uid_filter">文件夹背景只抓壁纸层（默认开）</string>
    <string name="settings_bg_uid_filter_desc">Launcher 文件夹背景只抓壁纸层，排除 app 轨迹/shade 等非壁纸层。</string>
    <string name="settings_bg_wallpaper_file_source">文件夹背景用壁纸文件解码（默认开）</string>
    <string name="settings_bg_wallpaper_file_source_desc">静态壁纸零持续抓屏，仅壁纸变化重解码；动态壁纸自动回退抓屏。</string>
    <string name="settings_bg_wallpaper_max_dim">壁纸解码最大边长（px）</string>
    <string name="settings_bg_wallpaper_max_dim_value">%1$d px</string>
    <string name="settings_bg_wallpaper_max_dim_desc">壁纸整幅解码上限，防内存过高，裁剪精度足够。</string>
    <string name="settings_section_cc_blur">系统控制中心模糊</string>
    <string name="settings_cc_blur_strength">系统模糊力度（%）</string>
    <string name="settings_cc_blur_strength_value">%1$d%%</string>
    <string name="settings_cc_blur_strength_desc">调整系统控制中心背景模糊力度，100=系统原值，0=不模糊。开启时阻止界面缩小。</string>
    <string name="settings_keep_system_cc_blur">保留系统控制中心模糊（默认开）</string>
    <string name="settings_keep_system_cc_blur_desc">开启保留系统背景模糊（力度可调、阻止缩小）；关闭则背景透明露壁纸。</string>
    <string name="settings_remove_panel_mix_color">移除面板材质底色（默认开）</string>
    <string name="settings_remove_panel_mix_color_desc">去掉系统面板背景那层灰底（它不随模糊力度缩放，力度滑杆管不到）；模糊本身照常保留。</string>

    <!-- 文字与可读性 -->
    <string name="settings_text_contrast">文字背景反转取色（默认开）</string>
    <string name="settings_text_contrast_desc">按背景亮度自动反转文字黑白，关闭走系统原逻辑。</string>
    <string name="settings_heads_up_text_follow">弹出通知文字跟随整体颜色（默认开）</string>
    <string name="settings_heads_up_text_follow_desc">通知横幅文字：遮罩开强制白，关时按背景深浅自动变字色。</string>
    <string name="settings_text_force_refresh_interval">文字周期强制刷新间隔</string>
    <string name="settings_text_force_refresh_interval_value">%1$d ms</string>
    <string name="settings_text_force_refresh_interval_desc">按间隔全树重扫文字颜色兜底同屏统一，0=仅事件触发。</string>

    <!-- 遮罩 -->
    <string name="settings_mask">黑遮罩（默认开）</string>
    <string name="settings_mask_desc">玻璃元素叠加黑色半透明遮罩压暗背景保证可读性（文字强制白已独立开关）。</string>
    <string name="settings_mask_alpha">遮罩不透明度</string>
    <string name="settings_mask_alpha_value">%1$.2f</string>
    <string name="settings_mask_alpha_desc">遮罩不透明度，0.00 透明，1.00 全黑，默认 0.45。</string>
    <string name="settings_mask_text_color">文字强制白颜色</string>
    <string name="settings_mask_text_color_white">纯白</string>
    <string name="settings_mask_text_color_lightgray">浅灰</string>
    <string name="settings_mask_text_color_gray">灰</string>
    <string name="settings_mask_text_color_desc">文字强制白开启时中性色文字统一为该颜色（彩色字尊重 app）。</string>
    <string name="settings_text_force_white">文字强制白（默认开）</string>
    <string name="settings_text_force_white_desc">玻璃区域内/横幅中性色文字恒白（与遮罩独立：可只要白字不要压暗，也可单独关解决闪动）。</string>

    <!-- 流体云 -->
    <string name="settings_seedling_card_glass">流体云液态玻璃（默认关）</string>
    <string name="settings_seedling_card_glass_desc">灵动岛（流体云）液态玻璃化总开关。横幅玻璃共用此开关。</string>
    <string name="settings_seedling_capsule_glass">小胶囊（小岛）也玻璃化（默认开）</string>
    <string name="settings_seedling_capsule_glass_desc">缩小状态的小胶囊一并加玻璃，用全圆角胶囊形状；关闭则只处理展开大卡片。</string>
    <string name="settings_seedling_expand_ratio">展开大卡片判定高度系数</string>
    <string name="settings_seedling_expand_ratio_value">%1$.2f</string>
    <string name="settings_seedling_expand_ratio_desc">子卡片高度 ≥ 状态栏高 × 系数判定为展开大卡，默认 0.6。</string>
    <string name="settings_seedling_corner_ratio">展开大卡片圆角系数</string>
    <string name="settings_seedling_corner_ratio_value">%1$.2f</string>
    <string name="settings_seedling_corner_ratio_desc">圆角 = min(宽,高) × 系数，默认 0.22。</string>
    <string name="settings_seedling_force_transparent_bg">透明卡片背景（默认开）</string>
    <string name="settings_seedling_force_transparent_bg_desc">展开卡片背景置透明，让液态玻璃透出。</string>

    <!-- 锁屏时钟 -->
    <string name="settings_lockscreen_clock_glass">锁屏大时钟液态玻璃（默认关）</string>
    <string name="settings_lockscreen_clock_glass_desc">锁屏大时钟数字以玻璃质感填充，与时钟同绘制层级。</string>
    <string name="settings_lockscreen_clock_blur">时钟玻璃数字磨砂（px，0=清晰透镜）</string>
    <string name="settings_lockscreen_clock_blur_value">%1$.0f px</string>

