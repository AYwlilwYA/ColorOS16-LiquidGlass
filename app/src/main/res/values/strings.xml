    <!-- [spec/64] 一键预设 + 同步打开 -->
    <string name="settings_anim_preset_title">一键预设</string>
    <string name="settings_anim_preset_desc">三档均为临界阻尼（ζ=1.0，不过冲），仅速度不同。点击后本组全部参数立即套用（需先开启上方开关）。</string>
    <string name="settings_anim_preset_default">恢复默认</string>
    <string name="settings_anim_preset_soft">柔和 0.50s</string>
    <string name="settings_anim_preset_mid">适中 0.42s</string>
    <string name="settings_anim_preset_crisp">利落 0.35s</string>
    <string name="settings_anim_preset_applied">已套用预设：%1$s</string>
    <string name="settings_anim_sync_open">同步打开</string>
    <string name="settings_anim_sync_open_desc">把「打开动画」的全部参数整组复制到打断动画。</string>
    <string name="settings_anim_sync_done">已同步「打开动画」的参数</string>
    <string name="settings_anim_sync_not_ready">框架服务未就绪，请稍后重试</string>

    <!-- 桌面 Dock 栏液态玻璃（doc/spec/66，2026-09-16） -->
    <string name="cat_desktop">桌面</string>
    <string name="cat_desktop_desc">桌面元素的液态玻璃</string>
    <string name="settings_dock_glass">Dock 栏液态玻璃</string>
    <string name="settings_dock_glass_desc">给桌面底部常驻图标条加液态玻璃背景。系统在直板机上原本不对 Dock 绘制任何背景，开启后由模块接管。改动即时生效，无需重启桌面。</string>

    <!-- iOS 动态倾斜 / 透视（doc/spec/65，2026-09-16，实验性） -->
    <string name="cat_tilt">倾斜与透视</string>
    <string name="cat_tilt_desc">应用打开/退出时的 3D 倾斜（实验性）</string>
    <string name="settings_anim_tilt_enabled">开启动态倾斜</string>
    <string name="settings_anim_tilt_enabled_desc">实验性功能：应用打开/退出/打断动画期间窗口与图标产生 iOS 风格 3D 倾斜。默认关闭。</string>
    <string name="settings_anim_tilt_strength">倾斜强度</string>
    <string name="settings_anim_tilt_strength_desc" formatted="false">调节前后倾斜角度；0% 为不倾斜，200% 为两倍角度。</string>
    <string name="settings_anim_tilt_strength_value">%1$d%%</string>
    <string name="settings_anim_tilt_perspective">透视扭曲程度</string>
    <string name="settings_anim_tilt_perspective_desc" formatted="false">调节上下宽度差；0% 无近大远小效果，数值越大透视越明显（倾斜强度为 0% 时此项无效）。</string>
    <string name="settings_anim_tilt_perspective_value">%1$d%%</string>
    <string name="settings_anim_tilt_restart_note">提示：本功能为实验性，改动需重启桌面进程生效。</string>

