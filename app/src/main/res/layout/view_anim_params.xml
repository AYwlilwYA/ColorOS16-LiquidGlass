<?xml version="1.0" encoding="utf-8"?>
<!-- [doc/spec/64] 桌面动画参数三级页（打开/关闭/打断三组共用，键名由代码按组拼装） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Switch
            android:id="@+id/switchAnimEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_anim_enable_custom" />

        <TextView
            android:id="@+id/animEnabledDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_anim_enable_custom_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 中心 X 轴 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_anim_sec_x"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_anim_damping"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <SeekBar
            android:id="@+id/seekAnimXDamping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="290"
            android:progress="130" />

        <TextView
            android:id="@+id/animXDampingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_anim_stiffness"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <SeekBar
            android:id="@+id/seekAnimXStiffness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2999"
            android:progress="579" />

        <TextView
            android:id="@+id/animXStiffnessValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 中心 Y 轴 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_anim_sec_y"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_anim_damping"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <SeekBar
            android:id="@+id/seekAnimYDamping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="290"
            android:progress="130" />

        <TextView
            android:id="@+id/animYDampingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_anim_stiffness"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <SeekBar
            android:id="@+id/seekAnimYStiffness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2999"
            android:progress="579" />

        <TextView
            android:id="@+id/animYStiffnessValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 宽度缩放 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_anim_sec_width"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_anim_damping"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <SeekBar
            android:id="@+id/seekAnimWidthDamping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="290"
            android:progress="130" />

        <TextView
            android:id="@+id/animWidthDampingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_anim_stiffness"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <SeekBar
            android:id="@+id/seekAnimWidthStiffness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2999"
            android:progress="579" />

        <TextView
            android:id="@+id/animWidthStiffnessValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 宽高比例 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_anim_sec_height"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_anim_damping"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <SeekBar
            android:id="@+id/seekAnimHeightDamping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="290"
            android:progress="130" />

        <TextView
            android:id="@+id/animHeightDampingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_anim_stiffness"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <SeekBar
            android:id="@+id/seekAnimHeightStiffness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2999"
            android:progress="579" />

        <TextView
            android:id="@+id/animHeightStiffnessValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 图标透明度 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_anim_sec_fade"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <SeekBar
            android:id="@+id/seekAnimFadeDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="145"
            android:progress="29" />

        <TextView
            android:id="@+id/animFadeDurationValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_anim_restart_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>
</ScrollView>
