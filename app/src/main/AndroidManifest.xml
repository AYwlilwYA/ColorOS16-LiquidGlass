<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      LibXposed 模块的模块身份声明（实证来源）：
      - 入口类注册：src/main/resources/META-INF/xposed/java_init.list
      - 模块元信息：src/main/resources/META-INF/xposed/module.prop（minApiVersion/targetApiVersion）
      - 注入作用域：src/main/resources/META-INF/xposed/scope.list
        （com.android.systemui：Hook B/C 绘制与场景过滤；com.oplus.blur：Hook A 拦截未模糊原图）
      见 api 源码 package-info.java 的 "Entry Registration / Module Configuration / Scope" 章节。
      与同类 Xposed 模块（META-INF/xposed 三件套）做法一致。

      android:label / android:description 会被框架作为模块名与描述读取（ApplicationInfo）。
      LSPosed 兼容：设置入口 Activity 声明
      category=de.robv.android.xposed.category.MODULE_SETTINGS（反编译实证）。
      未加 xposedmodule meta-data（新式 LibXposed 框架不依赖它，见 package-info.java）。
    -->

    <!--
      [2026-09-17 升级提示] 启动时请求 GitHub Releases API 比对版本号。
      仅用于该检查（api.github.com），模块不向任何其它地址发请求。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 包可见性声明（hook 安装分发与设置页读取宿主信息用） -->
    <queries>
        <package android:name="com.android.systemui" />
        <package android:name="com.android.launcher" />
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.LiquidGlass"
        android:supportsRtl="true">

        <!-- 模块配置界面（Material You 动态取色）；LAUNCHER=桌面启动图标 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 日志文件分享通道：设置页分享抓取文件（captures/）走 content uri -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
